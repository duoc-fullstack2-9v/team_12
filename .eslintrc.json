{
    "root": true,
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": [
        "eslint:recommended"
    ],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "overrides": [
        {
            "files": [
                "src/test/**/*.{js,jsx}"
            ],
            "globals": {
                "describe": "readonly",
                "test": "readonly",
                "expect": "readonly",
                "vi": "readonly",
                "beforeAll": "readonly",
                "afterAll": "readonly",
                "jest": "readonly"
            }
        }
    ]
}